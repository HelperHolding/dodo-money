{
  "name": "Help Desk dodo-money",
  "nodes": [
    {
      "id": "848fd1a5-6966-48d1-9ca0-51385a4c79e2",
      "name": "Cada minuto",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
