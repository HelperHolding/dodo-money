    {
      "id": "4713b577-219b-4895-ab11-24739d557661",
      "name": "Enviar correo",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        660,
        0
      ],
      "onError": "continueErrorOutput",
      "credentials": {
        "smtp": {
          "id": "PIYhrRSVazBc0OGo",
          "name": "SMTP account"
        }
      },
      "parameters": {
        "fromEmail": "Dodo Pizza México <hola@dodopizza.mx>",
        "toEmail": "={{ $json.para }}",
        "subject": "={{ $json.asunto }}",
        "emailFormat": "both",
        "text": "={{ $json.texto }}",
        "html": "={{ $json.html }}",
        "options": {
          "appendAttribution": false,
          "replyTo": "hola@dodopizza.mx"
        }
      }
    },
    {
      "id": "30028376-fa08-4ab4-80a2-e434018162e2",
      "name": "Clasificar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const src = $('Uno por uno').item;\nif (!src?.json?.envio_id) throw new Error('Falta envio_id del lote');\nconst ok = !$json.error && Array.isArray($json.accepted) && $json.accepted.map(String).map(x=>x.toLowerCase()).includes(String(src.json.para).toLowerCase());\nconst detalle = ok ? null : String($json.error?.message ?? $json.error ?? $json.response ?? 'Resultado incierto').slice(0, 1500);\nreturn { json: { envio_id: src.json.envio_id, aceptado: ok, message_id: $json.messageId ?? null, detalle } };"
      }
    },
    {
      "id": "55520067-3181-43b3-907d-6e09114d7b21",
      "name": "Reportar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://dodo-money-j31t.vercel.app/api/correos/resultado",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 30000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "id": "b10998c6-1bbe-449b-bccc-7377db0cbe45",
      "name": "Pausa",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1320,
        0
      ],
