        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://dodo-money-j31t.vercel.app/api/correos/siguiente",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"lote\":8}",
        "options": {
          "timeout": 30000
        }
      }
