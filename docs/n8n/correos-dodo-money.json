      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://dodo-money-j31t.vercel.app/api/correos/siguiente",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"lote\":8}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "417ea52c-7455-4f80-98d7-9d9d2e697e2d",
