    {
      "id": "46f2f1dc-c8bb-4699-8ca8-84e80da6d752",
      "name": "Enviar correo",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        660,
        0
      ],
      "onError": "continueErrorOutput",
      "credentials": {
        "smtp": {
          "id": "PIYhrRSVazBc0OGo",
          "name": "SMTP account"
        }
      },
      "parameters": {
        "fromEmail": "Dodo Pizza México <hola@dodopizza.mx>",
        "toEmail": "={{ $json.para }}",
        "subject": "={{ $json.asunto }}",
        "emailFormat": "both",
        "text": "={{ $json.texto }}",
        "html": "={{ $json.html }}",
        "options": {
          "appendAttribution": false,
          "replyTo": "hola@dodopizza.mx"
        }
      }
    },
    {
      "id": "8c9ad0fc-a249-4afb-90e4-24ceb040e68b",
      "name": "Clasificar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const ok = !$json.error && Array.isArray($json.accepted) && $json.accepted.map(String).map(x=>x.toLowerCase()).includes(String($('Uno por uno').item.json.para).toLowerCase());\nconst detalle = ok ? null : String($json.error?.message ?? $json.error ?? $json.response ?? 'Resultado incierto').slice(0, 1500);\nreturn { json: { envio_id: $('Uno por uno').item.json.envio_id, aceptado: ok, message_id: $json.messageId ?? null, detalle } };"
      }
    },
    {
      "id": "4383f983-1ad9-4e36-b0e9-d6e420701443",
      "name": "Reportar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
