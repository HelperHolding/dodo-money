      ],
      "parameters": {
        "method": "POST",
        "url": "https://dodo-money-j31t.vercel.app/api/correos/resultado",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "9f1dd58a-b0b3-4972-9b03-238c6d8ef93c",
      "name": "Pausa",
